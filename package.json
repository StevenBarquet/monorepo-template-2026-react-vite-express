{
  "name": "monorepo-trcp-remplate-2026",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/preinstall/index.mjs",
    "front": "npm run dev --workspace=frontend",
    "front-build": "npm run build --workspace=frontend",
    "front-prod": "npm run prod --workspace=frontend",
    "space_2": "---------------------------BACKEND--------------------------------",
    "back": "npm run dev --workspace=backend",
    "back-build": "npm run build --workspace=backend",
    "back-prod": "npm run prod --workspace=backend",
    "back-typecheck": "npm run typecheck --workspace=backend",
    "back-test": "npm run test --workspace=backend",
    "back-coverage": "npm run coverage --workspace=backend",
    "space_3": "---------------------------GENERATORS--------------------------------",
    "generate-query": "npx plop --plopfile generators/backend/plopfile.js",
    "generate-comp": "npx plop --plopfile generators/frontend/plopfile.js",
    "generate-store": "npx plop --plopfile generators/frontend/plopfile-store.js",
    "generate-form": "npx plop --plopfile generators/frontend/plopfile-form.js",
    "generate-page": "npx plop --plopfile generators/frontend/plopfile-page.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "git-last-commit": "1.0.1",
    "plop": "4.0.5",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  }
}
