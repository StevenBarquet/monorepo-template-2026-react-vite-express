{
  "name": "backend",
  "version": "2.0.0",
  "type": "module",
  "description": "A basic starter for an express.js v5 API with Typescript",
  "license": "MIT",
  "keywords": [],
  "main": "src/index.ts",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node --import=tsx src/index.ts",
    "dev": "cross-env NODE_ENV=development DEBUG=app:* node --watch --import=tsx src/index.ts",
    "build": "tsc --noEmit",
    "prod": "cross-env NODE_ENV=production DEBUG=app:prod node --import=tsx src/index.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "2.8.6",
    "cross-env": "10.1.0",
    "debug": "4.4.3",
    "express": "5.2.1",
    "helmet": "8.2.0",
    "morgan": "1.11.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "26.1.0",
    "@types/supertest": "7.2.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.9",
    "eslint-plugin-format": "2.0.1",
    "supertest": "7.2.2",
    "tsx": "4.19.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
